{
  "name": "wedding-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @wedding-os/web dev",
    "build": "pnpm --filter @wedding-os/web build",
    "start": "pnpm --filter @wedding-os/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:apply-migrations": "tsx supabase/seed/apply_migrations.ts",
    "db:seed": "tsx supabase/seed/seed.ts",
    "db:ingest-photos": "tsx supabase/seed/ingest_photos.ts",
    "db:seed-scenarios": "tsx supabase/seed/seed_scenarios.ts",
    "db:seed-timeline": "tsx supabase/seed/seed_timeline_template.ts",
    "db:seed-availability": "tsx supabase/seed/seed_venue_availability.ts",
    "db:seed-estimates": "tsx supabase/seed/import_astha_estimates.ts",
    "db:migrate-planner-os": "tsx supabase/seed/migrate_to_planner_os.ts",
    "db:seed-playbook": "tsx supabase/seed/seed_playbook_template.ts",
    "db:seed-library": "tsx supabase/seed/seed_library.ts",
    "db:seed-library-media": "tsx supabase/seed/seed_library_media.ts",
    "db:seed-public-site": "tsx supabase/seed/seed_public_site.ts",
    "db:seed-library-from-proposal": "tsx supabase/seed/seed_library_from_proposal.ts",
    "db:seed-library-photos-from-web": "tsx supabase/seed/seed_library_photos_from_web.ts",
    "db:seed-marketing": "tsx supabase/seed/seed_astia_marketing.ts",
    "db:seed-demo-studio": "tsx supabase/seed/seed_demo_studio.ts",
    "db:seed-kc": "tsx supabase/seed/seed_kc_friend.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
