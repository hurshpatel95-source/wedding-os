# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Auth — used as the redirectTo for magic links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps embed — https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Static FX rate for EUR→USD display toggle (override later with live rate)
NEXT_PUBLIC_FX_EUR_USD=1.08

# Anthropic API key — server-side only. Powers the AI Excel column-mapping
# in the guest-list import wizard, and (later) pricing intake. Without it
# the import wizard falls back to header-name heuristics.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
