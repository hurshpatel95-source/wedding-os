.DS_Store
# macOS Finder duplicates ("* 2.tsx", "* 3.tsx", etc.) — never check these in.
# The [0-9] class catches any single-digit suffix (Finder uses 2, 3, 4...).
** [0-9].tsx
** [0-9].ts
** [0-9].md
** [0-9].sql
** [0-9].mjs
** [0-9].js
** [0-9].json

# Throwaway audit / one-off scripts agents leave behind in apps/web/.
# Convention: agents should write to /tmp/, not the repo. These names
# came up in real spills 2026-05-13.
apps/web/check-*.mjs
apps/web/ground-truth-*.mjs
apps/web/*-scratch.mjs

*.log
npm-debug.log*
pnpm-debug.log*

supabase/.branches/
supabase/.temp/
supabase/.env

# Agent worktrees (background subagents)
.claude/worktrees/

# Playwright smoke-test artifacts (T1.4)
test-results/
playwright-report/
playwright/.cache/
railway.json.staged
